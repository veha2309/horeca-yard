# Local PostgreSQL engine persists to .data/postgres when DATABASE_URL is empty.
DATABASE_URL=
DATA_DIR=.data/postgres
PORT=3000
APP_URL=http://localhost:3000
NODE_ENV=development
# Set these only when running npm run setup. Never commit real values.
OWNER_EMAIL=
OWNER_PASSWORD=
# Production requires PostgreSQL, HTTPS, object storage and SMTP.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
