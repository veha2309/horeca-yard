{
  "name": "horeca-yard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "node dist-server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "setup": "tsx server/setup.ts",
    "setup:local": "tsx server/setup-local.ts",
    "password:local": "tsx server/password-local.ts",
    "stop": "node scripts/stop.mjs",
    "migrate": "tsx server/migrate.ts",
    "typecheck": "tsc --noEmit",
    "bootstrap": "tsx scripts/bootstrap-firestore.ts",
    "deploy": "npm run build:web && firebase deploy",
    "build:web": "tsc --noEmit && vite build",
    "test:firestore": "FIREBASE_EMULATOR=1 tsx --test tests/firestore-workflow.test.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@electric-sql/pglite": "^0.3.14",
    "@vitejs/plugin-react": "^4.7.0",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "firebase": "^12.18.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.9",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jsdom": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^7.0.2",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.25.10",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vite": "^6.3.6"
  }
}
